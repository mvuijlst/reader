# Copy to .env and fill in. .env is gitignored.

# Django
DJANGO_SECRET_KEY=generate-one            # python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false                        # true only in development
DJANGO_ALLOWED_HOSTS=reader.yusupov.cloud
TIME_ZONE=Europe/Brussels

# Feed polling
READER_FETCH_INTERVAL_MINUTES=30          # how often each healthy feed is polled
READER_FETCH_WORKERS=8                    # parallel downloads per run
READER_AUTO_READ_DAYS=30                  # unread items older than this get marked read (0 = never)
READER_KEEP_DAYS=180                      # delete read, unstarred items older than this (0 = keep all)
